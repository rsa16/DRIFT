:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /v1/* {
		root * /drift/snapshots
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
}
